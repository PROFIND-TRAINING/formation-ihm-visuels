@startuml
skinparam dpi 150
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam monochrome false
skinparam actorBorderColor #333333
skinparam actorBackgroundColor #FFFFFF
skinparam usecaseBorderColor #333333
skinparam usecaseBackgroundColor #FFFFFF
skinparam rectangleBorderColor #333333
skinparam ArrowColor #333333
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFBEA
skinparam sequenceLifeLineBorderColor #333333
skinparam sequenceParticipantBorderColor #333333
skinparam sequenceParticipantBackgroundColor #FFFFFF
skinparam sequenceGroupBorderColor #333333
skinparam defaultFontSize 17
hide footbox
title sd UC01 — scénario nominal (2/2) : charge et fin de session
actor Usager
actor Véhicule as V
participant ":Borne B22" as B
actor Superviseur as S
ref over Usager, V, B, S : début de session (1/2)
loop toutes les 60 s
  B ->> S : MeterValues
end
Usager ->> B : présenterBadge(uid)
B ->> S : StopTransaction
B ->> Usager : afficher(énergie délivrée)
V ->> B : déconnecter()
@enduml
