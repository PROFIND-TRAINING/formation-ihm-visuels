@startuml
left to right direction
skinparam dpi 150
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam monochrome false
skinparam actorBorderColor #333333
skinparam actorBackgroundColor #FFFFFF
skinparam usecaseBorderColor #333333
skinparam usecaseBackgroundColor #FFFFFF
skinparam rectangleBorderColor #333333
skinparam ArrowColor #333333
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFBEA
actor Usager
actor "Carte\ncontrôleur" as CC
actor "Écran" as E
rectangle "Borne B22" {
  usecase "Recharger" as R
  usecase "Lire le badge" as LB
  usecase "Vérifier le badge" as VB
  usecase "Fermer le contacteur" as FC
  usecase "Mesurer l'énergie" as ME
}
Usager -- LB
Usager -- R
CC -- FC
CC -- ME
R ..> LB : <<include>>
LB ..> VB : <<include>>
VB ..> FC : <<include>>
R -- E
@enduml
